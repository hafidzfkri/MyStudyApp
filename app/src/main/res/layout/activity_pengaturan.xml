<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollPengaturan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:overScrollMode="always"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutPengaturan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="48dp">

        <!-- ================================================= -->
        <!-- JUDUL -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvJudulPengaturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/judul_pengaturan"
            android:textColor="@color/warna_teks_utama"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubPengaturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sub_pengaturan"
            android:textColor="@color/warna_teks_sekunder"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- A. BAHASA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_bahasa"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgBahasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbIndonesia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/radio_bahasa_id"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/radio_bahasa_en"
                    android:textColor="@color/warna_teks_utama" />

            </RadioGroup>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- B. TEMA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_tema"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTerang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/radio_terang"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbGelap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/radio_gelap"
                    android:textColor="@color/warna_teks_utama" />

            </RadioGroup>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- C. UKURAN TEKS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_ukuran"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgUkuran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKecil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/ukuran_kecil"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbSedang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/ukuran_sedang"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbBesar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/ukuran_besar"
                    android:textColor="@color/warna_teks_utama" />

            </RadioGroup>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- D. WARNA AKSEN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warna Aksen"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pilih warna utama aplikasi"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgWarna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbBiru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Biru"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbHijau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Hijau"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbUngu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Ungu"
                    android:textColor="@color/warna_teks_utama" />

            </RadioGroup>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- E. NOTIFIKASI -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_notifikasi"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/desc_notifikasi"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- F. RINGKASAN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kotak_ringkasan"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ringkasan"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRingkasan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warna_teks_utama"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStatusNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- G. RESET -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/btn_reset"
            android:textColor="@color/warna_tombol_reset" />

    </LinearLayout>

</ScrollView>